// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  alt         String
  price       Int    @default(60)
  description String
  image       String
  category    String
}
